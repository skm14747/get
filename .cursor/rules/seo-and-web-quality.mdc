description: Indexing, metadata, content, and web-quality rules for GoEasyTools pages.
globs: app/**/*.ts, app/**/*.tsx, lib/seo.ts, lib/site.ts, lib/tools.ts, components/*guide*.tsx, components/tool-page.tsx, components/related-tools.tsx
alwaysApply: false
