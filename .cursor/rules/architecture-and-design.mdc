description: Module boundaries for the GoEasyTools Next.js app. Pure tool logic stays separate from pages and client UI.
globs: app/**/*.ts, app/**/*.tsx, components/**/*.tsx, lib/**/*.ts, locales/**/*.ts, next.config.ts
alwaysApply: false
