# Optional credentials for a future keyword refresh.
# The 2026-10-24 research pass did not call these APIs and did not spend money.
# Leave the values empty. Do not commit real secrets.

# Google Ads Keyword Planner. Requires an approved Google Ads developer token
# and OAuth credentials. Used only to read historical search volume and bid ranges.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Third-party SEO estimates. Treat results as estimates, not ground truth.
AHREFS_API_TOKEN=
SEMRUSH_API_KEY=
MOZ_API_TOKEN=

# Public site configuration. These are not secrets. Leave the contact address
# empty until a real inbox exists. Leave analytics empty until a collector exists.
# Do not put tool inputs into either value.
NEXT_PUBLIC_SITE_URL=https://goeasytools.com
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
